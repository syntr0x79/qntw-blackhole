FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash ca-certificates conntrack coreutils iproute2 jq \
       libnetfilter-conntrack3 netcat-openbsd nftables openssl \
       python3 ruby tcpdump tshark util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
ENTRYPOINT ["/bin/bash"]
